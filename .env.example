# Copy to .env next to docker-compose.yml. No keys go here: TMDB, Plex and Telegram are set in
# the app (Settings → Connections) and stored encrypted in /data.
TZ=UTC
PUID=99
PGID=100
# Folder on the host that holds your Movies, TV Shows and other library folders.
MEDIA_DIR=/mnt/user/Media
# Folder on the host for Linkarr's own data.
APPDATA_DIR=/mnt/user/appdata/linkarr
# 0 only if you open Linkarr over plain http (no HTTPS). Sign-in won't stick otherwise.
LA_COOKIE_SECURE=1
